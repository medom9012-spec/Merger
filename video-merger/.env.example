# انسخ هذا الملف إلى .env وضع القيم الحقيقية (لا ترفع .env إلى المستودع أبداً)

# بيانات الاتصال بقاعدة بيانات Turso (إلزامي)
# أنشئ قاعدة مجانية على https://turso.tech ثم انسخ الرابط والرمز
TURSO_DATABASE_URL=libsql://YOUR-DB-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE

# حدود اختيارية (القيم الافتراضية أدناه)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
