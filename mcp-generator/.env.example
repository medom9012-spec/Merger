# ============================================================
# انسخ هذا الملف إلى .env.local محليًا — أو أضف القيم نفسها في
# Vercel → Settings → Environment Variables
# ============================================================

# إلزاميان — قاعدة Turso (libSQL عبر HTTP)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# خدمة دمج الفيديو Video Merger v2 — تُضبط بعد نشرها (اختياري حتى ذلك الحين)
# MERGER_API_BASE=https://<your-merger-service>.vercel.app

# اختياري
MCP_ACCESS_TOKEN=            # إن ضُبط يُطلب Bearer token على /mcp
KIE_IMAGE_MODEL=             # تجاوز أسماء الموديلات إن لزم
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
MAX_WAIT_SECONDS=45          # سقف نافذة انتظار الأدوات داخل الاستدعاء الواحد
