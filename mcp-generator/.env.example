# ==== قاعدة Turso (إلزامي) ====
# أنشئ قاعدة مجانية: turso db create <name> ثم:
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ==== خدمة دمج الفيديو (اختياري) ====
# بدونها تعمل كل الأدوات ما عدا merge_videos (تُعاد رسالة إرشادية عربية)
MERGER_API_BASE=

# ==== حماية /mcp (اختياري) ====
# إن ضُبط يُطلب الترويسة: Authorization: Bearer <token>
MCP_ACCESS_TOKEN=

# ==== تجاوز أسماء الموديلات لدى المزودين (اختياري) ====
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
